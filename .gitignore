# SAM 3 is a git submodule (facebookresearch/sam3); installed via `pip install -e ./sam3`

# Model checkpoints (kept outside the repo)
ckpt/
*.pt
*.pth
*.safetensors
*.ckpt

# Gradio / runtime temp artifacts
**/tmp_gradio/

# Pipeline run outputs (now written to ../outputs, i.e. /root/project/outputs)
outputs/

# Local input media (kept out of git); README documents what's used
input/*
!input/README.txt

# Local .env (secrets); keep .env.example tracked
.env

# Python
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# macOS
.DS_Store

# Runtime env (contains HF_TOKEN etc.) — keep out of git
runtime_env.sh
# HuggingFace cache (SAM3 weights etc.)
.hf_home/
# Eval generated artifacts (reproducible from prompt_spec.yaml + code)
eval/configs/
eval/results/
eval/run_logs/
eval/manifest.json
eval/summary.md
eval/summary.csv

jobs/
